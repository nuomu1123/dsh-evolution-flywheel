{
  "name": "dsh-evolution-flywheel",
  "version": "1.0.0",
  "description": "dsh-evolution-flywheel：错误感知、子母对抗审核、跨学科夜间漫游与人类最高裁决。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "THE_GENESIS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "node --import ./test/setup.mjs --test test/plugin.test.mjs test/clarify.test.mjs test/client.test.mjs test/memory.test.mjs test/state-machine.test.mjs test/telemetry.test.mjs test/logic.test.mjs test/strategy.test.mjs test/decay.test.mjs test/curator.test.mjs test/probes.test.mjs test/repair-guards.test.mjs test/client-logic-extra.test.mjs test/browser-observer.test.mjs test/redact.test.mjs test/insight-pipeline.test.mjs test/stream-resilience.test.mjs test/repair-acceptance.test.mjs test/critic.test.mjs",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "evolution",
    "flywheel",
    "self-audit",
    "clarify",
    "meta-cognition",
    "multi-agent",
    "human-in-the-loop",
    "self-evolving",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuomu1123/dsh-evolution-flywheel.git"
  },
  "bugs": {
    "url": "https://github.com/nuomu1123/dsh-evolution-flywheel/issues"
  },
  "homepage": "https://github.com/nuomu1123/dsh-evolution-flywheel#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
